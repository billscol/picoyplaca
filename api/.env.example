APP_NAME=picoyplaca-api
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=picoyplaca
DB_USER=root
DB_PASS=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=picoyplaca

# JWT (generar con bin/generate-jwt-keys.php)
JWT_PRIVATE_KEY_PATH=storage/keys/private.pem
JWT_PUBLIC_KEY_PATH=storage/keys/public.pem
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
MAX_SESSIONS=10

# CORS
CORS_ORIGINS=http://localhost:3020,http://localhost:3021

# Rate limiting (fallback sin plan)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Agente semanal — Search API (DataForSEO por defecto)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Agente semanal — extraccion LLM
OPENAI_API_KEY=
OPENAI_MODEL_MINI=gpt-4o-mini

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

LOG_LEVEL=info
LOG_FORMAT=text
